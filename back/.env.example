PORT=4000
NODE_ENV=development
ENABLE_BRIEFING_SCHEDULER=false
DATABASE_URL=postgresql://localhost:5432/aura
# Set DATABASE_SSL=true for managed providers (Supabase, Neon, RDS).
# Auto-enabled when NODE_ENV=production unless explicitly DATABASE_SSL=false.
DATABASE_SSL=false
# REDIS_URL is optional. Without it the backend uses in-memory rate limiting
# (fine for single-instance deployments). Required if you run >1 API replica.
REDIS_URL=redis://localhost:6379
# Supabase Auth — backend verifies JWTs issued by Supabase Client SDK on device.
# All three required in production.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — Gmail scope is requested separately by the device for downstream API access.
# Client secret only needed if backend ever exchanges Gmail refresh tokens.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
OPENWEATHERMAP_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Required in production (server.ts will refuse to boot without it). Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=
USAGE_RATE_PER_MINUTE=12
USAGE_DAILY_NEWS_BRIEFING=40
USAGE_DAILY_EMAIL_SUMMARY=40
USAGE_DAILY_OVERVIEW=30
USAGE_DAILY_CHAT=100
USAGE_DAILY_MANUAL_REFRESH=10
USAGE_DAILY_TOKEN_BUDGET=200000
ANTHROPIC_INPUT_COST_PER_MTOK=3
ANTHROPIC_OUTPUT_COST_PER_MTOK=15
CORS_ALLOWED_ORIGINS=
IP_RATE_LIMIT_PER_MINUTE=120
