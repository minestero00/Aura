# ============================================================================
# AURA Backend — 환경변수 전체 목록
#
# 이 파일은 production/staging/dev 모든 환경에 필요한 변수 목록의
# single source of truth. 새 변수 추가 시 여기에 먼저 등록 + back/CLAUDE.md
# 의 "환경변수" 섹션도 업데이트.
#
# 표기:
#   [필수]   — preflight가 boot 거부 (NODE_ENV=production 시)
#   [필수-prod] — production 한정 필수
#   [선택]   — 미설정 시 backend 기본값/fallback 사용
#   [기능]   — 해당 기능 켜야 의미 있음
#
# 비밀값은 Railway/Supabase 대시보드에 직접 입력. 이 파일에는 형식만.
# ============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development           # [선택] development | production
PORT=4000                      # [선택] 기본 4000
ENABLE_BRIEFING_SCHEDULER=false # [기능] worker 서비스에서만 true. API는 항상 false.
PRECHECK_STRICT=true           # [선택] false로 두면 preflight 우회 (디버깅용, prod 비권장)

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# Session pooler URL 사용 (port 5432). Direct connection은 IPv6 only라 한국망에서 ENOTFOUND.
# 비밀번호에 특수문자(!, @, #, %, /, : 등)가 있으면 URL-encode 필수 — `!` → `%21` 등.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres  # [필수]
DATABASE_SSL=true              # [선택] production이면 자동 true. Supabase/Neon/RDS 등 managed PG 시 true.

# ── Cache (Redis) ──────────────────────────────────────────────────────────
# 단일 인스턴스에서는 미설정도 OK — backend가 in-memory rate limit으로 fallback.
# 멀티 인스턴스(replicas≥2)면 반드시 설정 + REDIS_URL_REQUIRED=true로 강제 가드.
# Railway Redis 사용 시 ${{Redis.REDIS_URL}} reference 형식 권장.
REDIS_URL=                     # [선택]
REDIS_URL_REQUIRED=false       # [선택] true로 두면 preflight가 REDIS_URL 강제 검증

# ── Supabase Auth ──────────────────────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co  # [필수]
SUPABASE_JWT_SECRET=              # [필수] HS256 fallback. JWKS 우선 사용되나 legacy/백업.
SUPABASE_SERVICE_ROLE_KEY=        # [필수] backend가 admin API 호출 시 사용

# ── 보안 / CORS ────────────────────────────────────────────────────────────
# AES-256-GCM 토큰 암호화 키. 64 hex chars 또는 base64(32 bytes). 생성:
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=               # [필수-prod]
# 모바일 전용이면 비워둬도 OK (CORS 핸들러가 origin 헤더 없는 요청은 통과).
# Web admin/마케팅 origin 추가 시 콤마 구분: https://admin.aura.app,https://www.aura.app
CORS_ALLOWED_ORIGINS=             # [선택]
# IP rate limit
IP_RATE_LIMIT_PER_MINUTE=120      # [선택] 기본 120
IP_RATE_LIMIT_PER_5MIN=400        # [선택] 기본 400

# ── Google OAuth ───────────────────────────────────────────────────────────
# 3개 client(web/iOS/Android) 모두 등록 — backend가 idToken aud claim 검증.
GOOGLE_WEB_CLIENT_ID=             # [필수]
GOOGLE_IOS_CLIENT_ID=             # [필수]
GOOGLE_ANDROID_CLIENT_ID=         # [필수]
# Gmail/Calendar refresh 시 backend가 token endpoint 호출에 필요.
GOOGLE_CLIENT_SECRET=             # [기능] Gmail/Calendar 통합 사용 시 필수
GOOGLE_MAPS_API_KEY=              # [기능] transit 모듈(directions/etc)에서 사용

# ── 외부 API ───────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=           # [기능] /weather/today 사용 시 필수
ANTHROPIC_API_KEY=                # [필수] news/email/chat/brief 요약
ANTHROPIC_MODEL=claude-sonnet-4-6 # [필수] 기본 모델
# 단순 요약(news_briefing, email_summary)에 쓸 저비용 모델. 미설정 시 ANTHROPIC_MODEL 폴백.
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001  # [선택] 권장 — ~5x 절감
ANTHROPIC_INPUT_COST_PER_MTOK=3   # [선택] usage 비용 추적용 단가
ANTHROPIC_OUTPUT_COST_PER_MTOK=15 # [선택] usage 비용 추적용 단가

# Tago Bus API (한국 버스 도착 정보) — transit 모듈
TAGO_BUS_API_KEY=                 # [기능] Bus arrival 알림 사용 시
TAGO_BUS_API_BASE_URL=            # [선택] 기본 https://apis.data.go.kr/...
TAGO_BUS_DEFAULT_CITY_CODE=       # [선택] 기본 도시 코드 (서울 25)

# FCM (Firebase Cloud Messaging) — push notification dispatch
FCM_SERVER_KEY=                   # [기능] 푸시 알림 사용 시

# ── 사용량 가드 (per-user daily quota) ─────────────────────────────────────
USAGE_RATE_PER_MINUTE=12          # [선택] feature별 분당 호출 한도
USAGE_DAILY_NEWS_BRIEFING=40      # [선택]
USAGE_DAILY_EMAIL_SUMMARY=40      # [선택]
USAGE_DAILY_OVERVIEW=30           # [선택]
USAGE_DAILY_CHAT=100              # [선택]
USAGE_DAILY_MANUAL_REFRESH=10     # [선택]
USAGE_DAILY_TOKEN_BUDGET=200000   # [선택] 0이면 budget 가드 비활성. 권장 200k.

# ── 운영 알림 (선택) ───────────────────────────────────────────────────────
# 둘 중 하나만 설정해도 동작. 5xx에러 / token budget 80%·100% 임계 시 webhook.
OPS_SLACK_WEBHOOK_URL=            # [선택]
OPS_DISCORD_WEBHOOK_URL=          # [선택]

# ── Slack Bot (slack-bot 기능 사용 시 추가) ────────────────────────────────
# GitHub App — worker.ts의 digest loop에서 installation token 발급에 사용
# 설정 방법: slack-bot/SETUP.md Step 3 참고
GITHUB_APP_ID=                    # [기능] GitHub App의 숫자 App ID
GITHUB_APP_PRIVATE_KEY=           # [기능] GitHub App Private Key (PEM). 줄바꿈은 \n 로 치환 후 한 줄로 입력
#
# 아래 두 가지도 확인:
#   APP_ENCRYPTION_KEY — 이미 위에서 설정. web/.env.local의 BOT_ENCRYPTION_KEY와 동일해야 함
#   DATABASE_URL — 이미 위에서 설정. bot_installations, bot_digest_logs 테이블 접근
#   (마이그레이션 0019_slack_bot.sql + 0020_github_app.sql 실행 필요 — slack-bot/SETUP.md 참고)

# ── 내부 (개발 시 .env 위치 명시 — 일반적으로 미사용) ─────────────────────
# AURA_ENV_FILE=./.env            # [선택]
