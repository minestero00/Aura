{
  "name": "aura-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "AURA_ENV_FILE=./.env tsx src/server.ts",
    "dev:worker": "AURA_ENV_FILE=./.env tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node scripts/migrate.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:rebuild": "npm run db:reset && npm run db:seed",
    "preflight:prod": "node scripts/preflight.mjs",
    "smoke:worker": "node scripts/smoke-worker-queue.mjs",
    "smoke:usage": "tsx scripts/smoke-usage.ts",
    "smoke:transit": "tsx scripts/smoke-transit.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@types/multer": "^2.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.4.1",
    "firebase-admin": "^13.9.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "stripe": "^22.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
