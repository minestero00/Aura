<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  Placeholder for RNKakaoLogins native init. KAKAO_LOGIN_ENABLED env가 false라
	  실제 Kakao 호출은 일어나지 않지만, 네이티브 모듈은 앱 부팅 시 자동
	  생성되어 Bundle.main.object(forInfoDictionaryKey: "KAKAO_APP_KEY")를
	  강제 언래핑한다. nil이면 앱 즉시 크래시 — 빈 문자열은 안 됨(KakaoSDK
	  내부에서 별도 검증). 카카오 출시 검수 통과 시 이 값을 실제 native
	  app key로 교체.
	-->
	<key>KAKAO_APP_KEY</key>
	<string>placeholder-not-used</string>
	<!--
	  Export Compliance — AURA frontend는 HTTPS(TLS) 외에 별도 암호화 미사용.
	  Backend의 AES-256-GCM은 server-side. false 명시로 TestFlight 업로드 시
	  매번 다이얼로그 응답하는 절차 제거.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Aura</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1009976239077-teat0o47lpsirkhfa47p92ug0ha1uqod</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.dumbteam.aura.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aura</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>10</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>googlegmail</string>
		<string>mailto</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Aura reads your device calendar to show today and tomorrow schedules.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Aura uses your microphone to record voice questions and transcribe them with Whisper.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Aura는 카톡 기프티콘 등 쿠폰 이미지에서 텍스트를 인식해 지갑에 자동 등록하기 위해 사진 접근이 필요합니다. Aura needs photo library access to recognize coupon images (KakaoTalk gifts etc.) on-device and save them to your wallet.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Aura reads your device calendar to show today and tomorrow schedules.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Aura uses your location to calculate departure times for upcoming schedules.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Aura tracks your route in the background while you are on a bus or subway, so it can alert you one stop before your destination even when the screen is off.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Aura tracks your route in the background to alert you one stop before your destination.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
