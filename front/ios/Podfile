# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AuraApp' do
  # @react-native-firebase가 static linking + Swift import를 위해 요구.
  # GoogleUtilities/FirebaseCoreInternal이 modular_headers 없으면 install 단계에서 실패.
  use_modular_headers!

  # RNCPushNotificationIOS는 Swift bridging header에서 직접 import되므로 module map이
  # 명확히 생성되어야 함. use_modular_headers!만으로는 가끔 정의 누락 — 명시적으로 강제.
  pod 'RNCPushNotificationIOS', :path => '../../node_modules/@react-native-community/push-notification-ios', :modular_headers => true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        build_configuration.build_settings["CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES"] = "YES"
        build_configuration.build_settings["SWIFT_ENABLE_EXPLICIT_MODULES"] = "NO"
        build_configuration.build_settings["CLANG_ENABLE_MODULES"] = "YES"
        if target.name == "RNCPushNotificationIOS"
          build_configuration.build_settings["DEFINES_MODULE"] = "YES"
        end
      end
    end
  end
end
