default_platform(:ios)

# App Store Connect API Key 로드. .p8 파일은 fastlane/keys/AuthKey.p8 (gitignored).
# Key ID / Issuer ID는 env (front/.env 또는 shell export).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_KEY_FILEPATH"] || File.expand_path("keys/AuthKey.p8", __dir__),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "TestFlight 베타 배포 — build number 자동 bump + Archive + Upload"
  lane :beta do
    api_key = asc_api_key

    # 1) build number를 TestFlight 최신 + 1로 자동 bump (충돌 방지).
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dumbteam.aura",
      initial_build_number: 0
    )
    next_build = latest + 1
    increment_build_number(
      build_number: next_build,
      xcodeproj: "AuraApp.xcodeproj"
    )
    UI.message("📦 next build number: #{next_build}")

    # 2) Archive — App Store distribution.
    build_app(
      workspace: "AuraApp.xcworkspace",
      scheme: "AuraApp",
      export_method: "app-store",
      clean: true,
      output_directory: "build"
    )

    # 3) TestFlight 업로드. internal testing은 Apple 처리 후 자동 활성.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["BETA_CHANGELOG"] || "Latest build"
    )
  end

  desc "다음 build number만 미리 계산 (CI dry-run / 로컬 확인용)"
  lane :next_build do
    api_key = asc_api_key
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dumbteam.aura",
      initial_build_number: 0
    )
    UI.message("📦 next build number would be: #{latest + 1}")
  end
end
