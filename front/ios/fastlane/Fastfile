default_platform(:ios)

# App Store Connect API Key 로드. .p8 파일은 fastlane/keys/AuthKey.p8 (gitignored).
# Key ID / Issuer ID는 env (front/.env 또는 shell export).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_KEY_FILEPATH"] || File.expand_path("keys/AuthKey.p8", __dir__),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "TestFlight 베타 배포 — build number 자동 bump + Archive + Upload"
  lane :beta do
    api_key = asc_api_key

    # 1) build number를 TestFlight 최신 + 1로 자동 bump (충돌 방지).
    # ASC에 stuck/processing 상태가 있어 latest가 stale일 때는
    # `BUILD_NUMBER_OVERRIDE=N bundle exec fastlane beta`로 강제.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dumbteam.aura",
      initial_build_number: 0
    )
    override = ENV["BUILD_NUMBER_OVERRIDE"]
    next_build = override && !override.empty? ? override.to_i : latest + 1
    increment_build_number(
      build_number: next_build,
      xcodeproj: "AuraApp.xcodeproj"
    )
    UI.message("📦 next build number: #{next_build}#{override ? " (override)" : ""}")

    # 사전 조건: build/generated/ios/ReactCodegen/ 안에 RN codegen 산출물이 있어야 함.
    # fastlane의 cocoapods action은 RN 0.84 prebuilt artifact 흐름과 잘 안 맞아서
    # ShellError로 자주 깨짐. 따라서 별도 단계로 분리 — 빌드 전에 manually 실행:
    #   cd front/ios && pod install
    # 이후 fastlane beta. clean: false이므로 codegen 산출물은 보존됨.

    # 2) Archive — App Store distribution.
    # xcargs -allowProvisioningUpdates: archive/export 시 distribution profile을
    #   필요하면 Xcode가 자동 생성/갱신 (Apple Developer Portal에 요청).
    # export_options.signingStyle=automatic: Xcode Managed profile로 export.
    # clean: false — RN codegen 산출물 보존 (Pods.xcodeproj가 generated/ 경로 참조).
    build_app(
      workspace: "AuraApp.xcworkspace",
      scheme: "AuraApp",
      export_method: "app-store",
      clean: false,
      output_directory: "build",
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "WJ33W524N5"
      }
    )

    # 3) TestFlight 업로드. internal testing은 Apple 처리 후 자동 활성.
    # changelog는 env로 override 가능 (CI/스크립트 용도), 미지정 시 interactive prompt.
    # 빈 입력은 "Latest build"로 fallback (Upload는 changelog 없으면 직전 빌드 메시지 재사용).
    changelog = ENV["BETA_CHANGELOG"]
    if changelog.nil? || changelog.strip.empty?
      changelog = UI.input("📝 TestFlight changelog (이번 빌드에서 추가/수정된 내용을 한 줄 이상으로):")
    end
    changelog = "Latest build" if changelog.nil? || changelog.strip.empty?
    UI.message("📝 changelog: #{changelog.lines.first&.strip}…")

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: changelog
    )
  end

  desc "다음 build number만 미리 계산 (CI dry-run / 로컬 확인용)"
  lane :next_build do
    api_key = asc_api_key
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dumbteam.aura",
      initial_build_number: 0
    )
    UI.message("📦 next build number would be: #{latest + 1}")
  end

  desc "TestFlight 베타 그룹 / 빌드 / 테스터 출력"
  lane :list_beta_groups do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV["ASC_KEY_FILEPATH"] || File.expand_path("keys/AuthKey.p8", __dir__)
    )

    app = Spaceship::ConnectAPI::App.find("com.dumbteam.aura")
    UI.user_error!("앱을 찾을 수 없습니다: com.dumbteam.aura") unless app

    groups = app.get_beta_groups(includes: "betaTesters")

    if groups.empty?
      UI.important("BetaGroup 없음 — App Store Connect → TestFlight → 그룹 +로 생성 필요")
    end

    groups.each do |g|
      kind = g.is_internal_group ? "internal" : "external"
      UI.message("──────────────────────────")
      UI.message("Group: #{g.name} (#{kind}) id=#{g.id}")
      testers = g.beta_testers || []
      UI.message("  testers (#{testers.size}):")
      testers.each do |t|
        state = t.beta_tester_state || "?"
        installed = t.installed_cf_bundle_short_version_string
        installed_label = installed ? " · installed #{installed}(#{t.installed_cf_bundle_version}) on #{t.installed_device || "?"} iOS #{t.installed_os_version || "?"}" : ""
        UI.message("    - #{t.email}  state=#{state}#{installed_label}")
      end
      begin
        builds = g.fetch_builds(includes: "preReleaseVersion")
        build_labels = builds.map { |b| "#{b.app_version}(#{b.version})" }
        UI.message("  builds  (#{build_labels.size}): #{build_labels.join(", ")}")
      rescue => err
        UI.important("  builds 조회 실패: #{err.message}")
      end
    end
  end

  desc "기존 빌드를 베타 그룹에 attach — 예: bundle exec fastlane attach_build group:\"Internal Testers\" version:1.0 build:1"
  lane :attach_build do |options|
    UI.user_error!("group: 옵션 필수") unless options[:group]
    UI.user_error!("version: 옵션 필수 (예: 1.0)") unless options[:version]
    UI.user_error!("build: 옵션 필수 (예: 1)") unless options[:build]

    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV["ASC_KEY_FILEPATH"] || File.expand_path("keys/AuthKey.p8", __dir__)
    )

    app = Spaceship::ConnectAPI::App.find("com.dumbteam.aura")
    UI.user_error!("앱을 찾을 수 없습니다") unless app

    group = app.get_beta_groups.find { |g| g.name == options[:group] }
    UI.user_error!("그룹을 찾을 수 없습니다: #{options[:group]} — fastlane list_beta_groups 로 확인") unless group

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: options[:version],
      build_number: options[:build].to_s
    )
    build = builds.first
    UI.user_error!("빌드를 찾을 수 없습니다: #{options[:version]}(#{options[:build]})") unless build

    UI.message("🔗 attaching build #{build.app_version}(#{build.version}) → group #{group.name}")
    build.add_beta_groups(beta_groups: [group])
    UI.success("✅ 빌드가 그룹에 추가되었습니다. 테스터에게 알림이 발송됩니다.")
  end
end
