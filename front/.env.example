API_BASE_URL_IOS=http://127.0.0.1:4000
API_BASE_URL_ANDROID=http://10.0.2.2:4000

# Supabase — same project as ecommerce-dumb so users share auth.users (SSO).
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Google OAuth — used to mint an idToken that Supabase exchanges for a session.
# Use the SAME web client id that's registered in Supabase Auth → Providers → Google.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Kakao — Native App Key (NOT the REST API key). From Kakao Developers → 앱 설정 → 일반.
KAKAO_NATIVE_APP_KEY=
